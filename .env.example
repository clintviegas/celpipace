# Copy to .env.local and fill in real values. Never commit .env.local.
#
# The frontend (Vite) only reads VITE_-prefixed vars — those are the only
# ones exposed to the browser. Everything else is server-only, read by the
# Vercel functions in api/, and must never be given a VITE_ prefix.

# ── Client (Vite) ────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173
VITE_SENTRY_DSN=
VITE_CDN_URL=

# ── Supabase (server) ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_QUARTERLY=
# Optional: override the self-serve auto-refund window per plan (days).
# 0 disables auto-refund for that plan. See api/_lib/refunds.js.
# AUTO_REFUND_DAYS_WEEKLY=2
# AUTO_REFUND_DAYS_MONTHLY=7
# AUTO_REFUND_DAYS_ANNUAL=14
# AUTO_REFUND_MAX_PER_CUSTOMER=1

# ── AI scoring (api/score.js, api/transcribe-audio.js) ──────────────────
OPENAI_API_KEY=
SCORING_MODEL=
WHISPER_MODEL=

# ── Email — Brevo (api/_lib/brevo.js, api/_lib/email.js) ────────────────
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_LIST_FREE=
BREVO_LIST_PREMIUM=
BREVO_LIST_CANCELLED=
EMAIL_FROM=
CONTACT_TO_EMAIL=

# ── Cron / jobs (api/cron.js) ─────────────────────────────────────────────
# Must exactly match the vault secret pg_cron sends as its Bearer token
# (see supabase/migrations/20260806070000_pg_cron_schedule.sql). A mismatch
# here means retries and the reconciler silently stop running.
CRON_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://www.celpipace.ca
IP_HASH_SALT=
UNSUBSCRIBE_SECRET=
VERCEL_DEPLOY_HOOK_URL=
SENTRY_DSN=
SLACK_WEBHOOK_URL=

# ── Google Search Console (scripts/ops/gsc-pull.mjs) ─────────────────────
# GSC_SITE=
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
